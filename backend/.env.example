# Copy this file to ".env" and fill in your own values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Database: "sqlite" for development on your PC, "postgresql" for production
DB_ENGINE=sqlite

# Only used when DB_ENGINE=postgresql
DB_NAME=smart_dustbin
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Only needed when using the React dev server (npm run dev)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email alerts (optional). Without EMAIL_HOST, emails are saved in backend/sent_emails/
# Gmail: turn on 2-step verification, create an "App password" (16 letters) and use it below.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DEFAULT_FROM_EMAIL=Edge-AI Smart Dustbin <your.address@gmail.com>
# SITE_URL=http://192.168.1.10:8000
